# Anthropic API キー（必須）
ANTHROPIC_API_KEY=your_api_key_here

# 管理画面（/admin）のパスワード（必須。未設定だとサーバは起動しない）
# HTTP Basic 認証。ユーザー名は任意（何を入れてもよい）、パスワードだけを照合する。
ADMIN_PASSWORD=change-me

# 任意：DBファイルの場所（未設定なら data/sakumon.db。Render では /data/sakumon.db）
# DATABASE_PATH=/data/sakumon.db

# 任意：CORS で許可するオリジン（カンマ区切り。未設定なら localhost:8000 / 127.0.0.1:8000 / sakumon.onrender.com）
# ALLOWED_ORIGINS=https://sakumon.onrender.com

# 任意：使用モデル（未設定なら claude-sonnet-5）
# ANTHROPIC_MODEL=claude-sonnet-5
